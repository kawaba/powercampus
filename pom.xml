<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>jp.powercampus</groupId>
    <artifactId>powercampus</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>PowerCampus System</name>
    <description>PowerCampus Educational Management System</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Jakarta Servlet API -->
        <servlet.api.version>6.0.0</servlet.api.version>
        <!-- Jakarta Mail -->
        <jakarta.mail.version>2.0.1</jakarta.mail.version>
        <!-- Commons IO -->
        <commons.io.version>2.17.0</commons.io.version>
        <!-- Log4j 2.x -->
        <log4j.version>2.24.1</log4j.version>
        <!-- Jersey 3.x (Jakarta版) -->
        <jersey.version>3.1.7</jersey.version>
        <!-- Spring Framework -->
        <spring.version>6.1.14</spring.version>
        <!-- PostgreSQL JDBC Driver -->
        <postgresql.version>42.7.4</postgresql.version>
    </properties>

    <dependencies>
        <!-- Servlet API (アプリサーバー提供のため provided) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Mail API (Jakarta) -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>${jakarta.mail.version}</version>
        </dependency>

        <!-- Jakarta Activation API -->
        <dependency>
            <groupId>jakarta.activation</groupId>
            <artifactId>jakarta.activation-api</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Commons IO -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons.io.version}</version>
        </dependency>

        <!-- Log4j 2.x -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <!-- Log4j 1.x互換ブリッジ（既存コードをそのまま使える） -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-1.2-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- JAX-RS API (Jakarta) -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- Jersey 3.x (Jakarta版) -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-server</artifactId>
            <version>${jersey.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet</artifactId>
            <version>${jersey.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <version>${jersey.version}</version>
        </dependency>

        <!-- XML Security -->
        <dependency>
            <groupId>org.apache.santuario</groupId>
            <artifactId>xmlsec</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Spring Web (CharacterEncodingFilter用) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- プロジェクト内カスタム JAR（install-file 済み想定） -->
        <dependency>
            <groupId>jp.tkxtools</groupId>
            <artifactId>tkxtools</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>net.sf.orangesignal</groupId>
            <artifactId>orangesignal-csv</artifactId>
            <version>1.2.5</version>
        </dependency>

        <!-- Swing Layout（テスト用途） -->
        <dependency>
            <groupId>org.swinglabs</groupId>
            <artifactId>swing-layout</artifactId>
            <version>1.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>powercampus</finalName>

        <resources>
            <resource>
                <directory>resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- WAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <webResources>
                        <!-- htmlsフォルダをWARのルートに配置 -->
                        <resource>
                            <directory>htmls</directory>
                            <targetPath></targetPath>
                        </resource>

                        <!-- cssフォルダ -->
                        <resource>
                            <directory>css</directory>
                            <targetPath>css</targetPath>
                        </resource>

                        <!-- helpフォルダ -->
                        <resource>
                            <directory>help</directory>
                            <targetPath>help</targetPath>
                        </resource>

                        <!-- imagesフォルダ -->
                        <resource>
                            <directory>images</directory>
                            <targetPath>images</targetPath>
                        </resource>

                        <!-- launchフォルダ -->
                        <resource>
                            <directory>launch</directory>
                            <targetPath>launch</targetPath>
                        </resource>

                        <!-- sysimgフォルダ -->
                        <resource>
                            <directory>sysimg</directory>
                            <targetPath>sysimg</targetPath>
                        </resource>

                        <!-- topフォルダ -->
                        <resource>
                            <directory>top</directory>
                            <targetPath>top</targetPath>
                        </resource>

                        <!-- systemフォルダ（Apache設定で保護済み） -->
                        <resource>
                            <directory>system</directory>
                            <targetPath>system</targetPath>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <!-- Resources Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Install custom JARs to local repository -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>install-tkxtools</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${basedir}/lib/tkxtools.jar</file>
                            <groupId>jp.tkxtools</groupId>
                            <artifactId>tkxtools</artifactId>
                            <version>1.0.0</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-orangesignal-csv</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${basedir}/lib/orangesignal-csv-1.2.5-with-jlha.jar</file>
                            <groupId>net.sf.orangesignal</groupId>
                            <artifactId>orangesignal-csv</artifactId>
                            <version>1.2.5</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>